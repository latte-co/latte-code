{
  // Embedding configuration. The lattecode CLI currently reads LATTE_* variables.
  "database": { "path": ".latte/lattecode.db" },
  "runtime": { "command_buffer": 32, "event_buffer": 128 },
  "providers": {
    "primary": {
      "base_url": "${LATTE_OPENAI_ENDPOINT}",
      "api_key": "${LATTE_OPENAI_API_KEY}"
    }
  }
}
