{
  "version": 1,
  "default_provider": "primary",
  "thread": {
    "max_request_bytes": 524288,
    "max_input_bytes": 393216,
    "reserved_output_bytes": 131072,
    "context_cap_bytes": 65536
  },
  "verification": { "argv": ["cargo", "test", "--workspace"], "cwd": ".", "timeout_ms": 120000 },
  "providers": {
    "primary": {
      "type": "openai-chat",
      "model": "gpt-4o",
      "base_url": "https://api.openai.com/v1",
      "api_key": { "source": "env", "name": "OPENAI_API_KEY" },
      "timeout_ms": 60000,
      "max_attempts": 1,
      "streaming": true,
      "compatibility_input_request": false,
      "credential_ref_id": "openai-primary-env",
      "data_scope_id": "workspace",
      "credential_generation": 1,
      "aliases": {}
    }
  }
}
