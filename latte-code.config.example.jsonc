{
  "version": 1,
  "default_model": "primary/model-id",
  "thread": {
    "max_request_bytes": 524288,
    "max_input_bytes": 393216,
    "reserved_output_bytes": 131072,
    "context_cap_bytes": 65536
  },
  "verification": { "argv": ["cargo", "test", "--workspace"], "cwd": ".", "timeout_ms": 120000 },
  "providers": {
    "primary": {
      "type": "openai-chat",
      "models": {
        "model-id": {
          "name": "Model display name",
          "options": { "context_window": 128000, "max_tokens": 16384 }
        }
      },
      "base_url": "https://provider.example/v1",
      // A literal string is also supported: "api_key": "sk-..."
      "api_key": { "source": "env", "name": "OPENAI_API_KEY" },
      "timeout_ms": 60000,
      "max_attempts": 1,
      "streaming": true,
      "compatibility_input_request": false,
      "aliases": {}
    }
  }
}
